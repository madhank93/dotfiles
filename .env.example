# Copy to ~/.env — NOT stowed, NOT git-tracked (LAN IP stays off GitHub).
# aider auto-loads ~/.env, so this applies in every repo.
#
# Homelab ollama endpoint (Cilium LoadBalancer).
# Fallback if the LoadBalancer IP changes:
#   kubectl -n ollama port-forward svc/ollama 11434:11434
#   OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_API_BASE=http://<lan-ip>:11434
